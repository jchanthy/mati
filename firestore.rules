rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection: Allow read and write for registered Google accounts
    match /users/{userId} {
      allow read, write: if true;
    }

    // Rooms, polls, and votes collections
    match /rooms/{roomCode} {
      allow read, write: if true;

      // Allow all sub-collections (polls, votes)
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // Block any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
