rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Rooms collection
    match /rooms/{roomCode} {
      // Anyone can read rooms (needed for presenter stage and mobile participants)
      allow read: if true;
      // Allow creating and updating rooms (title, activePollId, status)
      allow create, update: if true;
      // Prevent deleting rooms inadvertently
      allow delete: if false;

      // Polls sub-collection
      match /polls/{pollId} {
        // Anyone in the room can read polls
        allow read: if true;
        // Allow creating/editing polls
        allow create, update: if true;
        allow delete: if false;

        // Votes sub-collection (Atomic, 1 vote per voterId)
        match /votes/{voterId} {
          // Anyone in the room can read aggregated vote results
          allow read: if true;
          // A voter can only write their own vote matching their voterId
          allow create, update: if request.resource.data.voterId == voterId 
                                && request.resource.data.optionId is number;
          // Prevent deleting votes
          allow delete: if false;
        }
      }
    }

    // Block access to any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
